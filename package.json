{
  "name": "prolific-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:landing",
    "dev:landing": "VITE_APP_TARGET=landing vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:sim": "VITE_APP_TARGET=simulator vite --host 0.0.0.0 --port 5174 --strictPort",
    "build": "npm run build:landing",
    "build:landing": "VITE_APP_TARGET=landing tsc && VITE_APP_TARGET=landing vite build",
    "build:sim": "VITE_APP_TARGET=simulator tsc && VITE_APP_TARGET=simulator vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
